# Optional Google Drive connection. Only the client ID is public.
VITE_GOOGLE_CLIENT_ID=

# Server-only authentication settings. Never give these a VITE_ prefix.
# The exact served origin, with no trailing slash. Local example: http://localhost:5173
DRIVE_APP_ORIGIN=https://genealogical3.vercel.app
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes as 64 hexadecimal characters (see README).
DRIVE_SESSION_KEY=

# Public deployment identity. Change these when publishing your own fork.
# PUBLIC_APP_URL must be an HTTPS origin; PUBLIC_REPOSITORY_URL must be a GitHub repo.
# Empty/unset values keep the original project's defaults shown here.
PUBLIC_APP_URL=https://genealogical3.vercel.app
PUBLIC_DEVELOPER_NAME=Jorge Hernandez
PUBLIC_REPOSITORY_URL=https://github.com/zenzontle/genealogical3

# Optional public contact email. Published on the privacy and terms pages during the build.
# Leave empty to use the GitHub issue tracker. Rebuild/redeploy after changing it.
PRIVACY_CONTACT_EMAIL=
